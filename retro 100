        })
      );
      glowRing.position.y = 0.52;
      group.add(glowRing);

      const markerTexture = makeSpawnMarkerTexture();
      const marker = new THREE.Mesh(
        new THREE.PlaneGeometry(0.9, 0.9),
        new THREE.MeshStandardMaterial({
