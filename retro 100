    function addBlockAtHit(hit, isLazar = false) {
      if (!hit || !hit.face) return;

      const faceNormal = hit.face.normal.clone().transformDirection(hit.object.matrixWorld).normalize();

      let testY = blockHalf;
      if (hit.object.userData.isFloor) {
        testY = blockHalf;
      } else if (hit.object.userData.isBlock || hit.object.userData.isLazar || hit.object.userData.isSpawnPoint) {
        if (faceNormal.y > 0.5) {
          const targetHeight = hit.object.userData.isLazar ? slabHeight : (hit.object.userData.size?.y || blockSize);
          testY = hit.object.position.y + targetHeight / 2 + (isLazar ? slabHalf : blockHalf);
        } else {
          return;
        }
      }

      const testPos = new THREE.Vector3(
        Math.round(hit.point.x / blockSize) * blockSize,
        testY,
        Math.round(hit.point.z / blockSize) * blockSize
      );

      if (hit.object.userData.isFloor) {
        testPos.y = isLazar ? slabHalf : blockHalf;
      }

      const overlaps = placedBlocks.some((block) => {
        const b = blockAABB(block);
        const minX = testPos.x - blockHalf;
        const maxX = testPos.x + blockHalf;
        const minY = testPos.y - (isLazar ? slabHalf : blockHalf);
        const maxY = testPos.y + (isLazar ? slabHalf : blockHalf);
        const minZ = testPos.z - blockHalf;
        const maxZ = testPos.z + blockHalf;

        return maxX > b.minX && minX < b.maxX && maxY > b.minY && minY < b.maxY && maxZ > b.minZ && minZ < b.maxZ;
      });

      if (overlaps) return;

      let block;
      if (isLazar) {
        const material = createLazarMaterial(selectedBlockColor);
        block = new THREE.Mesh(slabGeometry, material);
        const glowLight = new THREE.PointLight(new THREE.Color(selectedBlockColor), 1.8, 5.5, 2);
        glowLight.position.set(0, 0.2, 0);
        block.add(glowLight);
        block.userData.isLazar = true;
        block.userData.size = { x: 1, y: slabHeight, z: 1 };
      } else {
        const blockMaterial = new THREE.MeshStandardMaterial({
          map: blockTexture,
          color: new THREE.Color(selectedBlockColor),
          roughness: 0.96,
          metalness: 0.02
        });
        block = new THREE.Mesh(blockGeometry, blockMaterial);
        block.userData.size = { x: blockSize, y: blockSize, z: blockSize };
      }

      block.position.copy(testPos);
      block.castShadow = true;
      block.receiveShadow = true;
      block.userData.isBlock = true;
      scene.add(block);
      placedBlocks.push(block);
      selectedBlock = block;
    }

    function placeLazarAtHit(hit) {
      addBlockAtHit(hit, true);
    }

    function removeBlockAtHit(hit) {
      if (!hit || !hit.object || !hit.object.userData.isBlock) return;

      const idx = placedBlocks.indexOf(hit.object);
      if (idx !== -1) placedBlocks.splice(idx, 1);

      if (selectedBlock === hit.object) {
        selectedBlock = null;
      }

      if (hit.object.userData.isSpawnPoint) {
        if (spawnPoint && spawnPoint === hit.object) {
          spawnPoint = null;
        }
      }

      scene.remove(hit.object);
      hit.object.geometry.dispose();

      if (hit.object.material && !Array.isArray(hit.object.material)) {
        hit.object.material.dispose();
      }

      if (hit.object.children) {
        hit.object.children.forEach((child) => {
          if (child.isPointLight) {
            child.dispose?.();
          }
        });
      }
    }

    function createSpawnPointMesh(position) {
      const group = new THREE.Group();

      const slab = new THREE.Mesh(
        new THREE.BoxGeometry(1.5, 0.4, 1.5),
        new THREE.MeshStandardMaterial({
          color: 0x2b2d33,
