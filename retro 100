    function resizeSelectedBlock(axis, direction) {
      const step = 0.5;
      const sign = direction === 'up' || direction === 'right' || direction === 'forward' ? 1 : -1;

      if (!selectedBlock) return;

      const current = selectedBlock.userData.size || {
        x: selectedBlock.userData.isLazar ? 1 : blockSize,
        y: selectedBlock.userData.isLazar ? slabHeight : blockSize,
        z: selectedBlock.userData.isLazar ? 1 : blockSize
      };

      if (axis === 'x') {
        const next = current.x + step * sign;
        selectedBlock.position.x += (step * sign) / 2;
        setBlockDimensions(selectedBlock, next, current.y, current.z);
      } else if (axis === 'y') {
        const next = current.y + step * sign;
        selectedBlock.position.y += (step * sign) / 2;
        setBlockDimensions(selectedBlock, current.x, next, current.z);
      } else if (axis === 'z') {
        const next = current.z + step * sign;
        selectedBlock.position.z += (step * sign) / 2;
        setBlockDimensions(selectedBlock, current.x, current.y, next);
      }
    }

    function spawnSlashEffect(position) {
      const mesh = new THREE.Mesh(
        new THREE.PlaneGeometry(2.1, 1.1),
