<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Green Floor Texture Builder</title>
  <style>
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #111;
      font-family: Arial, sans-serif;
      touch-action: none;
      -webkit-user-select: none;
      user-select: none;
    }

    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
      touch-action: none;
    }

    .hud {
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      color: white;
      background: rgba(0,0,0,0.25);
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 13px;
      letter-spacing: 0.05em;
      pointer-events: none;
      text-align: center;
      backdrop-filter: blur(4px);
    }

    .status-hud {
      position: absolute;
      top: 58px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(0,0,0,0.3);
      color: white;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      pointer-events: none;
      z-index: 35;
      white-space: nowrap;
    }

    .placement-panel {
      position: absolute;
      top: 18px;
      left: 18px;
      z-index: 30;
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(0, 0, 0, 0.28);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 12px;
      padding: 8px 12px;
      color: white;
      backdrop-filter: blur(4px);
      pointer-events: auto;
    }

    .placement-panel label {
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
    }

    .placement-panel select {
      background: rgba(255,255,255,0.10);
      color: white;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 13px;
      outline: none;
    }

    .resize-panel {
      position: absolute;
      left: 18px;
      top: 76px;
      z-index: 29;
      background: rgba(0,0,0,0.25);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 12px;
      padding: 8px;
      color: white;
      backdrop-filter: blur(4px);
      pointer-events: auto;
    }

    .resize-title {
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.8);
      margin-bottom: 6px;
      text-align: center;
    }

    .resize-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }

    .resize-btn {
      width: 54px;
      height: 32px;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.06);
      color: white;
      border-radius: 8px;
      font-size: 11px;
      cursor: pointer;
    }

    .resize-btn:hover {
      background: rgba(255,255,255,0.12);
    }

    .mode-toggle {
      position: absolute;
      right: 20px;
      top: 20px;
      z-index: 11;
      background: rgba(0,0,0,0.35);
      color: white;
      border: 1px solid rgba(255,255,255,0.2);
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 13px;
      cursor: pointer;
      pointer-events: auto;
      user-select: none;
    }

    .mode-toggle.play {
      background: rgba(67, 110, 188, 0.8);
      border-color: rgba(255,255,255,0.35);
    }

    .eraser-toggle {
      position: absolute;
      right: 20px;
      top: 70px;
      z-index: 10;
      background: rgba(0,0,0,0.35);
      color: white;
      border: 1px solid rgba(255,255,255,0.2);
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 13px;
      cursor: pointer;
      pointer-events: auto;
      user-select: none;
    }

    .eraser-toggle.active {
      background: rgba(188, 67, 67, 0.8);
      border-color: rgba(255,255,255,0.35);
    }

    .color-control {
      position: absolute;
      right: 20px;
      top: 120px;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(0,0,0,0.28);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 12px;
      padding: 8px 10px;
      color: white;
      pointer-events: auto;
      user-select: none;
      backdrop-filter: blur(4px);
    }

    .color-control label {
      font-size: 12px;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    .color-control input[type="color"] {
      width: 38px;
      height: 38px;
      border: none;
      background: transparent;
      padding: 0;
      cursor: pointer;
      border-radius: 10px;
    }

    .jump-button {
      position: absolute;
      right: 32px;
      bottom: 180px;
      width: 90px;
      height: 90px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.32);
      background: rgba(255,255,255,0.12);
      color: white;
      font-size: 18px;
      font-weight: bold;
      letter-spacing: 0.05em;
      pointer-events: auto;
      z-index: 10;
      box-shadow: inset 0 0 18px rgba(255,255,255,0.05);
    }

    .joystick {
      position: absolute;
      width: 120px;
      height: 120px;
      border-radius: 50%;
      background: rgba(255,255,255,0.08);
      border: 2px solid rgba(255,255,255,0.22);
      bottom: 28px;
      left: 28px;
      pointer-events: none;
      box-shadow: inset 0 0 18px rgba(255,255,255,0.05);
    }

    .joystick .stick {
      position: absolute;
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(255,255,255,0.25);
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      border: 2px solid rgba(255,255,255,0.35);
      pointer-events: none;
    }

    .lookPad {
      position: absolute;
      width: 150px;
      height: 150px;
      border-radius: 50%;
      right: 28px;
      bottom: 28px;
      background: rgba(255,255,255,0.04);
      border: 2px solid rgba(255,255,255,0.18);
      pointer-events: none;
      box-shadow: inset 0 0 18px rgba(255,255,255,0.04);
    }

    .lookPad .dot {
      position: absolute;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(255,255,255,0.25);
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      border: 2px solid rgba(255,255,255,0.35);
      pointer-events: none;
    }

    .player-hp-panel {
      position: absolute;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 12px;
      background: rgba(0,0,0,0.32);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: 12px;
      z-index: 25;
      pointer-events: none;
      color: white;
      backdrop-filter: blur(4px);
    }

    .player-hp-label {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.88);
      font-weight: bold;
    }

    .player-hp-bar {
      width: 120px;
      height: 12px;
      border-radius: 999px;
      background: rgba(90, 0, 0, 0.8);
      border: 1px solid rgba(255,255,255,0.2);
      overflow: hidden;
      position: relative;
    }

    .player-hp-fill {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 100%;
      background: linear-gradient(to right, #ff5c5c, #ff2c2c);
      border-radius: 999px;
    }

    .inventory-bar {
      position: fixed;
      left: 50%;
      bottom: 22px;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 10px 14px;
      border-radius: 18px;
      background: rgba(0, 0, 0, 0.28);
      border: 1px solid rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(4px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.2);
      z-index: 20;
      pointer-events: auto;
    }

    .slot {
      width: 76px;
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      position: relative;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
    }

    .slot:hover {
      transform: translateY(-1px);
    }

    .slot.active {
      background: rgba(255,255,255,0.12);
      border-color: rgba(255,255,255,0.28);
      box-shadow: inset 0 0 16px rgba(255,255,255,0.06);
    }

    .slot.selected {
      border-color: #63c8ff;
      box-shadow:
        inset 0 0 0 2px rgba(99, 200, 255, 0.7),
        0 0 0 2px rgba(99, 200, 255, 0.35);
      background: rgba(255,255,255,0.10);
    }

    .slot.selected::before {
      content: "";
      position: absolute;
      inset: 8px;
      border: 2px solid rgba(99, 200, 255, 0.95);
      border-radius: 12px;
      pointer-events: none;
      box-shadow: 0 0 10px rgba(99, 200, 255, 0.5);
    }

    .slot-label {
      position: absolute;
      bottom: 6px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 10px;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.9);
      font-weight: bold;
      text-transform: uppercase;
    }

    .sword-icon {
      position: relative;
      width: 42px;
      height: 42px;
      transform: rotate(35deg);
      filter: drop-shadow(0 3px 4px rgba(0,0,0,0.35));
    }

    .sword-icon .blade {
      position: absolute;
      left: 50%;
      top: 4px;
      transform: translateX(-50%);
      width: 4px;
      height: 22px;
      background: linear-gradient(to bottom, #f2f6ff, #dfe8ff 55%, #9ca9c4);
      border-radius: 2px;
      box-shadow: inset 0 0 2px rgba(255,255,255,0.8);
    }

    .sword-icon .blade::before {
      content: "";
      position: absolute;
      top: -9px;
      left: 50%;
      transform: translateX(-50%);
      width: 10px;
      height: 10px;
      background: linear-gradient(to bottom right, #f7fbff, #cad5ea);
      clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
    }

    .sword-icon .guard {
      position: absolute;
      left: 50%;
      top: 22px;
      transform: translateX(-50%);
      width: 26px;
      height: 8px;
      background: linear-gradient(to right, #d4c8a0, #f4e6b2, #d4c8a0);
      border-radius: 3px;
      box-shadow: inset 0 0 3px rgba(0,0,0,0.2);
    }

    .sword-icon .handle {
      position: absolute;
      left: 50%;
      top: 28px;
      transform: translateX(-50%);
      width: 6px;
      height: 16px;
      background: linear-gradient(to bottom, #6b3d23, #2a1a13);
      border-radius: 3px;
      box-shadow: inset 0 0 3px rgba(255,255,255,0.15);
    }

    .sword-icon .pommel {
      position: absolute;
      left: 50%;
      top: 42px;
      transform: translateX(-50%);
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #f7e7b5, #d9b85c 62%, #b3882d);
      box-shadow: 0 0 5px rgba(0,0,0,0.2);
    }

    @media (max-width: 768px) {
      .hud {
        font-size: 11px;
        padding: 8px 12px;
      }

      .placement-panel {
        top: 10px;
        left: 10px;
      }

      .resize-panel {
        top: 60px;
        left: 10px;
      }

      .player-hp-panel {
        top: 10px;
      }

      .mode-toggle, .eraser-toggle {
        font-size: 12px;
        padding: 8px 10px;
      }

      .color-control {
        top: 110px;
      }

      .jump-button {
        width: 78px;
        height: 78px;
        right: 24px;
        bottom: 170px;
        font-size: 16px;
      }

      .inventory-bar {
        bottom: 16px;
      }

      .slot {
        width: 64px;
        height: 64px;
      }

      .resize-btn {
        width: 46px;
        height: 30px;
      }
    }
  </style>
</head>
<body>
  <div class="hud">Move: left stick • Look: right pad • Tap to place/remove</div>
  <div id="statusHud" class="status-hud">Creative</div>

  <div class="player-hp-panel">
    <div class="player-hp-label">HP</div>
    <div class="player-hp-bar">
      <div class="player-hp-fill"></div>
    </div>
  </div>

  <div class="placement-panel">
    <label for="placementMode">Place</label>
    <select id="placementMode">
      <option value="block">Block</option>
      <option value="lazar">Lazar</option>
      <option value="spawn">Spawn</option>
      <option value="zombie">Zombie</option>
    </select>
  </div>

  <div class="resize-panel">
    <div class="resize-title">Resize</div>
    <div class="resize-grid">
      <div></div>
      <button class="resize-btn" data-axis="y" data-dir="up">Up</button>
      <div></div>

      <button class="resize-btn" data-axis="x" data-dir="left">Left</button>
      <button class="resize-btn" data-axis="z" data-dir="back">Back</button>
      <button class="resize-btn" data-axis="z" data-dir="forward">Fwd</button>

      <div></div>
      <button class="resize-btn" data-axis="y" data-dir="down">Down</button>
      <div></div>

      <button class="resize-btn" data-axis="x" data-dir="right">Right</button>
      <button class="resize-btn" data-axis="y" data-dir="up">Y+</button>
      <button class="resize-btn" data-axis="x" data-dir="left">X-</button>
    </div>
  </div>

  <button id="modeToggle" class="mode-toggle">Play Mode: OFF</button>
  <button id="eraserToggle" class="eraser-toggle">Eraser: OFF</button>

  <div class="color-control">
    <label for="blockColor">Block Color</label>
    <input id="blockColor" type="color" value="#9fe085" />
  </div>

  <button id="jumpButton" class="jump-button">JUMP</button>

  <div id="leftJoystick" class="joystick">
    <div class="stick"></div>
  </div>

  <div id="lookPad" class="lookPad">
    <div class="dot"></div>
  </div>

  <div id="inventoryBar" class="inventory-bar">
    <div id="swordSlot" class="slot active selected">
      <div class="sword-icon">
        <span class="blade"></span>
        <span class="guard"></span>
        <span class="handle"></span>
        <span class="pommel"></span>
      </div>
      <span class="slot-label">Sword</span>
    </div>
  </div>

  <script type="module">
    import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.164.1/build/three.module.js';

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x98ccff);
    scene.fog = new THREE.Fog(0x98ccff, 18, 120);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 500);
    camera.rotation.order = 'YXZ';

    const weapon = new THREE.Group();

    const bladeMaterial = new THREE.MeshStandardMaterial({
      color: 0xeaf1ff,
      metalness: 0.9,
      roughness: 0.18
    });

    const guardMaterial = new THREE.MeshStandardMaterial({
      color: 0xd8c68a,
      metalness: 0.8,
      roughness: 0.35
    });

    const handleMaterial = new THREE.MeshStandardMaterial({
      color: 0x47301d,
      roughness: 0.9
    });

    const pommelMaterial = new THREE.MeshStandardMaterial({
      color: 0xc69b2d,
      metalness: 0.7,
      roughness: 0.28
    });

    const blade = new THREE.Mesh(new THREE.BoxGeometry(0.08, 1.35, 0.06), bladeMaterial);
    blade.position.y = 0.7;

    const guard = new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.08, 0.12), guardMaterial);
    guard.position.y = 0.1;

    const handle = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.45, 0.08), handleMaterial);
    handle.position.y = -0.28;

    const pommel = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.08, 12), pommelMaterial);
    pommel.position.y = -0.56;

    weapon.add(blade, guard, handle, pommel);
    weapon.position.set(0.72, -0.58, 1.15);
    weapon.rotation.set(0.38, 0.22, -0.9);
    camera.add(weapon);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    document.body.appendChild(renderer.domElement);

    const hemi = new THREE.HemisphereLight(0xdff6ff, 0x2e452d, 1.3);
    scene.add(hemi);

    const sun = new THREE.DirectionalLight(0xffffff, 1.1);
    sun.position.set(12, 18, 8);
    sun.castShadow = true;
    sun.shadow.mapSize.set(2048, 2048);
    sun.shadow.camera.left = -60;
    sun.shadow.camera.right = 60;
    sun.shadow.camera.top = 60;
    sun.shadow.camera.bottom = -60;
    scene.add(sun);

    function makeGrassTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 256;
      const g = canvas.getContext('2d');

      const base = '#7acb62';
      const dark = '#4a9047';
      const mid = '#62bc55';
      const light = '#dff7bf';
      const speck = '#1d3a2a';

      g.fillStyle = base;
      g.fillRect(0, 0, 256, 256);

      const tile = 32;
      for (let y = 0; y < 256; y += tile) {
        for (let x = 0; x < 256; x += tile) {
          g.fillStyle = (x + y) % (tile * 2) === 0 ? dark : mid;
          g.fillRect(x, y, tile, tile);

          g.fillStyle = 'rgba(255,255,255,0.12)';
          g.fillRect(x + 4, y + 4, tile - 8, 5);

          g.fillStyle = 'rgba(25,35,20,0.14)';
          g.fillRect(x + 4, y + tile - 9, tile - 8, 5);

          g.fillStyle = light;
          g.fillRect(x + 7, y + 7, 6, 6);
          g.fillRect(x + tile - 13, y + 7, 6, 6);
          g.fillRect(x + 7, y + tile - 13, 6, 6);
          g.fillRect(x + tile - 13, y + tile - 13, 6, 6);
        }
      }

      for (let i = 0; i < 260; i++) {
        const px = Math.random() * 256;
        const py = Math.random() * 256;
        g.fillStyle = i % 2 === 0 ? '#eef9d9' : speck;
        g.fillRect(px, py, 2, 2);
      }

      return canvas;
    }

    function makeLazarTexture(colorHex) {
      const canvas = document.createElement('canvas');
      canvas.width = 64;
      canvas.height = 64;
      const g = canvas.getContext('2d');

      const base = new THREE.Color(colorHex);
      const dark = base.clone().multiplyScalar(0.25);
      const bright = base.clone().multiplyScalar(1.25);

      const glow = g.createRadialGradient(32, 32, 3, 32, 32, 30);
      glow.addColorStop(0, `rgba(${Math.round(bright.r * 255)}, ${Math.round(bright.g * 255)}, ${Math.round(bright.b * 255)}, 1)`);
      glow.addColorStop(0.25, `rgba(${Math.round(base.r * 255)}, ${Math.round(base.g * 255)}, ${Math.round(base.b * 255)}, 0.95)`);
      glow.addColorStop(0.6, `rgba(${Math.round(dark.r * 255)}, ${Math.round(dark.g * 255)}, ${Math.round(dark.b * 255)}, 0.8)`);
      glow.addColorStop(1, 'rgba(0,0,0,0.15)');

      g.fillStyle = '#111827';
      g.fillRect(0, 0, 64, 64);

      g.fillStyle = glow;
      g.fillRect(0, 0, 64, 64);

      g.strokeStyle = 'rgba(255,255,255,0.5)';
      g.lineWidth = 1.5;
      for (let i = 0; i < 6; i++) {
        const x = 8 + i * 8;
        g.beginPath();
        g.moveTo(x, 4);
        g.lineTo(x + 6, 60);
        g.stroke();
      }

      g.strokeStyle = 'rgba(255,255,255,0.2)';
      for (let i = 0; i < 7; i++) {
        const y = 8 + i * 8;
        g.beginPath();
        g.moveTo(0, y);
        g.lineTo(64, y);
        g.stroke();
      }

      const texture = new THREE.CanvasTexture(canvas);
      texture.colorSpace = THREE.SRGBColorSpace;
      return texture;
    }

    function createLazarMaterial(colorHex) {
      const color = new THREE.Color(colorHex);
      const dark = color.clone().multiplyScalar(0.4);
      const texture = makeLazarTexture(colorHex);

      return new THREE.MeshStandardMaterial({
        map: texture,
        color: dark,
        emissive: color,
        emissiveMap: texture,
        emissiveIntensity: 1.9,
        roughness: 0.35,
        metalness: 0.18
      });
    }

    function makeSpawnMarkerTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 256;
      const g = canvas.getContext('2d');

      g.clearRect(0, 0, 256, 256);

      g.fillStyle = '#f3f3f4';
      g.beginPath();
      g.arc(128, 128, 96, 0, Math.PI * 2);
      g.fill();

      g.fillStyle = '#ebebed';
      g.beginPath();
      g.arc(128, 128, 78, 0, Math.PI * 2);
      g.fill();

      g.fillStyle = '#eaf0ff';
      g.beginPath();
      g.arc(128, 128, 62, 0, Math.PI * 2);
      g.fill();

      g.fillStyle = '#ef4955';
      g.beginPath();
      g.arc(128, 128, 42, 0, Math.PI * 2);
      g.fill();

      g.fillStyle = '#ffffff';
      g.font = 'bold 86px Arial';
      g.textAlign = 'center';
      g.textBaseline = 'middle';
      g.fillText('S', 128, 128);

      const texture = new THREE.CanvasTexture(canvas);
      texture.colorSpace = THREE.SRGBColorSpace;
      return texture;
    }

    function makeSlashTexture() {
      const canvas = document.createElement('canvas');
      canvas.width = 256;
      canvas.height = 256;
