        })
      );
      marker.position.y = 0.64;
      marker.rotation.x = -Math.PI / 2;
      group.add(marker);

      group.position.copy(position);
      group.userData.isBlock = true;
      group.userData.isSpawnPoint = true;
      group.userData.size = { x: 1.5, y: 0.4, z: 1.5 };
      return group;
    }

    let spawnPoint = null;

    function removeSpawnPoint() {
      if (!spawnPoint) return;
      if (selectedBlock === spawnPoint) selectedBlock = null;
      scene.remove(spawnPoint);
      spawnPoint = null;
      setStatus('Creative');
    }

    function placeSpawnPointAtHit(hit) {
      if (!hit) return;

      const pos = hit.point.clone();
      const spawnHalf = 0.2;

      if (hit.object.userData.isFloor) {
        pos.y = 0.2;
      } else if (hit.object.userData.isBlock || hit.object.userData.isLazar || hit.object.userData.isSpawnPoint) {
        const targetHeight = hit.object.userData.size?.y || (hit.object.userData.isLazar ? slabHeight : blockSize);
        pos.y = hit.object.position.y + targetHeight / 2 + spawnHalf + 0.02;
      }

      const finalPos = new THREE.Vector3(
        Math.round(pos.x / blockSize) * blockSize,
        pos.y,
        Math.round(pos.z / blockSize) * blockSize
      );

      if (spawnPoint) {
        removeSpawnPoint();
      }

      const spawnMesh = createSpawnPointMesh(finalPos);
      scene.add(spawnMesh);
      spawnPoint = spawnMesh;
      setStatus('Spawn Point Ready');
    }

    function createZombieMesh(position) {
      const root = new THREE.Group();

      const skinMaterial = new THREE.MeshStandardMaterial({
        color: 0x6dbf64,
        roughness: 0.9
      });

      const darkMaterial = new THREE.MeshStandardMaterial({
        color: 0x2a5c34,
        roughness: 0.9
      });

      const body = new THREE.Mesh(new THREE.BoxGeometry(0.7, 1.2, 0.4), skinMaterial);
      body.position.y = 1.05;
      root.add(body);

      const head = new THREE.Mesh(new THREE.BoxGeometry(0.52, 0.52, 0.52), skinMaterial);
      head.position.y = 2.05;
      root.add(head);

      const eyeGeo = new THREE.BoxGeometry(0.06, 0.10, 0.02);
      const eyeMat = new THREE.MeshBasicMaterial({ color: 0x111111 });
      const leftEye = new THREE.Mesh(eyeGeo, eyeMat);
      const rightEye = new THREE.Mesh(eyeGeo, eyeMat);
      leftEye.position.set(-0.12, 2.12, 0.28);
      rightEye.position.set(0.12, 2.12, 0.28);
      root.add(leftEye, rightEye);

      const legGeo = new THREE.BoxGeometry(0.22, 0.7, 0.22);
      const leftLeg = new THREE.Mesh(legGeo, darkMaterial);
      const rightLeg = new THREE.Mesh(legGeo, darkMaterial);
      leftLeg.position.set(-0.16, 0.35, 0);
      rightLeg.position.set(0.16, 0.35, 0);
      root.add(leftLeg, rightLeg);

      const armGeo = new THREE.BoxGeometry(0.18, 0.7, 0.18);
      const leftArm = new THREE.Mesh(armGeo, skinMaterial);
      const rightArm = new THREE.Mesh(armGeo, skinMaterial);
      leftArm.position.set(-0.52, 1.1, 0);
      rightArm.position.set(0.52, 1.1, 0);
      root.add(leftArm, rightArm);

      const hpBg = new THREE.Mesh(
        new THREE.PlaneGeometry(1.2, 0.16),
        new THREE.MeshBasicMaterial({ color: 0x3a0909, transparent: true, opacity: 0.9 })
      );
      hpBg.position.set(0, 2.9, 0);

      const hpFill = new THREE.Mesh(
        new THREE.PlaneGeometry(1.1, 0.12),
        new THREE.MeshBasicMaterial({ color: 0xff2d2d, transparent: true, opacity: 0.98 })
      );
      hpFill.position.set(0, 2.9, 0.02);

      root.add(hpBg, hpFill);
      root.position.copy(position);
      root.castShadow = true;
      root.receiveShadow = true;
      root.userData.isZombie = true;

      return {
        mesh: root,
        hp: 2,
        maxHp: 2,
        speed: 1.55 + Math.random() * 0.7,
        radius: 0.46,
        damageCooldown: 0,
        hpFill,
        spawnPoint: position.clone()
      };
    }

    function updateZombieHealthBar(zombie) {
      const ratio = THREE.MathUtils.clamp(zombie.hp / zombie.maxHp, 0, 1);
      zombie.hpFill.scale.x = ratio;
      zombie.hpFill.position.x = -0.55 + 0.55 * ratio;
    }

    function zombieIntersectsBlockAt(zombie, x, z) {
      const minX = x - zombie.radius;
      const maxX = x + zombie.radius;
      const minZ = z - zombie.radius;
      const maxZ = z + zombie.radius;

      for (const block of placedBlocks) {
        const b = blockAABB(block);

        const xOverlap = maxX > b.minX && minX < b.maxX;
        const zOverlap = maxZ > b.minZ && minZ < b.maxZ;
        const yOverlap = zombie.mesh.position.y + 1.9 > b.minY && zombie.mesh.position.y < b.maxY;

        if (xOverlap && zOverlap && yOverlap) {
          return true;
        }
      }
      return false;
    }

    function removeZombie(zombie) {
      const index = zombies.indexOf(zombie);
      if (index !== -1) zombies.splice(index, 1);

      const templateIndex = zombieTemplates.findIndex((item) => {
        return item.position.distanceTo(zombie.spawnPoint) < 0.001;
      });

      if (templateIndex !== -1) {
        zombieTemplates.splice(templateIndex, 1);
      }

      scene.remove(zombie.mesh);
    }

    function resetZombiesToSpawn() {
      for (const zombie of zombies.slice()) {
        scene.remove(zombie.mesh);
      }
      zombies.length = 0;

      for (const template of zombieTemplates) {
        const zombie = createZombieMesh(template.position.clone());
        zombies.push(zombie);
        scene.add(zombie.mesh);
        updateZombieHealthBar(zombie);
      }
    }

    function removeZombieFromHit(hit) {
      if (!hit || !hit.object || !hit.object.userData.isZombie) return;
      const zombie = zombies.find((z) => z.mesh === hit.object);
      if (zombie) removeZombie(zombie);
    }

    function placeZombieAtHit(hit) {
      if (!hit || (!hit.object.userData.isFloor && !hit.object.userData.isBlock && !hit.object.userData.isSpawnPoint)) return;

      const pos = hit.point.clone();

      if (hit.object.userData.isFloor) {
        pos.y = 0;
      } else if (hit.object.userData.isBlock || hit.object.userData.isLazar || hit.object.userData.isSpawnPoint) {
        pos.y = hit.object.position.y + (hit.object.userData.size?.y || blockSize) / 2 + 0.4;
      }

      const spawn = new THREE.Vector3(
        Math.round(pos.x / blockSize) * blockSize,
        pos.y,
        Math.round(pos.z / blockSize) * blockSize
      );

      const zombie = createZombieMesh(spawn);
      zombieTemplates.push({ position: spawn.clone() });
      zombies.push(zombie);
      scene.add(zombie.mesh);
      updateZombieHealthBar(zombie);
    }

    function performSwordSwing(targetPoint = null) {
      if (player.attackCooldown > 0) return;

      player.attackCooldown = 0.38;
      swordSwingTimer = SWING_DURATION;

      let attackPoint;

      if (targetPoint) {
        attackPoint = targetPoint.clone();
      } else {
        const dir = new THREE.Vector3();
        camera.getWorldDirection(dir);
        attackPoint = player.pos.clone().add(new THREE.Vector3(0, 1.2, 0)).add(dir.multiplyScalar(2.6));
      }

      const attackRadius = 1.8;

      for (const zombie of zombies.slice()) {
        const zombiePos = zombie.mesh.position;
        const dist = zombiePos.distanceTo(attackPoint);

        if (dist <= attackRadius) {
          zombie.hp -= 1;
          spawnSlashEffect(zombiePos.clone());
          updateZombieHealthBar(zombie);

          if (zombie.hp <= 0) {
            removeZombie(zombie);
          }
        }
      }
    }

    function damagePlayer(amount) {
      if (player.hitFlash > 0) return;

      player.health -= amount;
      player.hitFlash = 0.5;

      if (player.health <= 0) {
        player.health = player.maxHealth;
        if (spawnPoint) {
          player.pos.set(spawnPoint.position.x, spawnPoint.position.y + 0.4, spawnPoint.position.z);
        } else {
          player.pos.set(0, 0, 12);
        }
        player.velocityY = 0;
      }

      updatePlayerHealthUI();
    }

    let selectedBlock = null;

    function handlePlaceOrErase(clientX, clientY) {
      if (isUiPointer(clientX, clientY)) return;

      getPointerFromClient(clientX, clientY);
      raycaster.setFromCamera(pointer, camera);

      const hitTargets = [
        floor,
        ...placedBlocks,
        ...zombies.map((z) => z.mesh)
      ];

      const hits = raycaster.intersectObjects(hitTargets, false);
      if (!hits.length) return;

      const hit = hits[0];

      if (hit.object.userData.isSpawnPoint) {
        selectedBlock = hit.object;
        return;
      }

      if (eraserMode) {
        if (hit.object.userData.isZombie) {
          removeZombieFromHit(hit);
        } else if (hit.object.userData.isBlock) {
          removeBlockAtHit(hit);
        }
        return;
      }

      if (placementMode === 'zombie') {
        placeZombieAtHit(hit);
        return;
      }

      if (placementMode === 'lazar') {
        placeLazarAtHit(hit);
        return;
      }

      if (placementMode === 'spawn') {
        placeSpawnPointAtHit(hit);
        return;
      }

      addBlockAtHit(hit);
    }

    renderer.domElement.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      if (isUiPointer(event.clientX, event.clientY)) return;
      event.preventDefault();

      if (playMode) {
        getPointerFromClient(event.clientX, event.clientY);
        raycaster.setFromCamera(pointer, camera);

        const hitTargets = [
          floor,
          ...placedBlocks,
          ...zombies.map((z) => z.mesh)
        ];

        const hits = raycaster.intersectObjects(hitTargets, false);
        let targetPoint = null;

        if (hits.length) {
          targetPoint = hits[0].point.clone();
        } else {
          const dir = new THREE.Vector3();
          camera.getWorldDirection(dir);
          targetPoint = player.pos.clone().add(new THREE.Vector3(0, 1.2, 0)).add(dir.multiplyScalar(3.5));
        }

        performSwordSwing(targetPoint);
        return;
      }

      getPointerFromClient(event.clientX, event.clientY);
      raycaster.setFromCamera(pointer, camera);

      const hitTargets = [
        floor,
        ...placedBlocks,
        ...zombies.map((z) => z.mesh)
      ];

      const hits = raycaster.intersectObjects(hitTargets, false);

      if (hits.length > 0 && hits[0].object.userData.isBlock) {
        selectedBlock = hits[0].object;
        return;
      }

      handlePlaceOrErase(event.clientX, event.clientY);
    });

    renderer.domElement.addEventListener('contextmenu', (event) => {
      event.preventDefault();
    });

    document.querySelectorAll('.resize-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const axis = btn.dataset.axis;
        const dir = btn.dataset.dir;
        resizeSelectedBlock(axis, dir);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Space'].includes(e.code)) {
        e.preventDefault();
      }

      if (e.code === 'KeyP') {
        if (!playMode && !spawnPoint) {
          setStatus('Need a Spawn Point');
          return;
        }

        const enteringPlay = !playMode;
        playMode = !playMode;
        updateModeButton();

        if (playMode) {
          if (spawnPoint) {
            player.pos.set(
              spawnPoint.position.x,
              spawnPoint.position.y + 0.4,
              spawnPoint.position.z
            );
            player.velocityY = 0;
            player.onGround = true;
            player.standingOnBlockTop = null;
            setStatus('Spawned');
          }
        } else {
          setStatus('Creative');
        }

        if (!enteringPlay) {
          resetZombiesToSpawn();
        }
      }

      if (e.code === 'KeyE') {
        if (!playMode) {
          eraserMode = !eraserMode;
          updateEraserButton();
        }
      }
      if (e.code === 'Space') jumpQueued = true;

      if (e.code === 'KeyW') keys.w = true;
      if (e.code === 'KeyS') keys.s = true;
      if (e.code === 'KeyA') keys.a = true;
      if (e.code === 'KeyD') keys.d = true;

      if (e.code === 'ArrowLeft') arrowKeys.left = true;
      if (e.code === 'ArrowRight') arrowKeys.right = true;
      if (e.code === 'ArrowUp') arrowKeys.up = true;
      if (e.code === 'ArrowDown') arrowKeys.down = true;
    });

    document.addEventListener('keyup', (e) => {
      if (e.code === 'KeyW') keys.w = false;
      if (e.code === 'KeyS') keys.s = false;
      if (e.code === 'KeyA') keys.a = false;
      if (e.code === 'KeyD') keys.d = false;

      if (e.code === 'ArrowLeft') arrowKeys.left = false;
      if (e.code === 'ArrowRight') arrowKeys.right = false;
      if (e.code === 'ArrowUp') arrowKeys.up = false;
      if (e.code === 'ArrowDown') arrowKeys.down = false;
    });

    let mouseDown = false;
    let lastMouseX = 0;
    let lastMouseY = 0;

    window.addEventListener('mousedown', (e) => {
      if (window.innerWidth <= 768) return;
      mouseDown = true;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
    });

    window.addEventListener('mousemove', (e) => {
      if (!mouseDown || window.innerWidth <= 768) return;
      const dx = e.clientX - lastMouseX;
      const dy = e.clientY - lastMouseY;
      player.yaw -= dx * 0.003;
      player.pitch -= dy * 0.002;
      player.pitch = THREE.MathUtils.clamp(player.pitch, -1.45, 1.45);
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
    });

    window.addEventListener('mouseup', () => {
      mouseDown = false;
    });

    const leftJoystick = document.getElementById('leftJoystick');
    const lookPad = document.getElementById('lookPad');
    const leftStick = leftJoystick.querySelector('.stick');
    const lookDot = lookPad.querySelector('.dot');

    let leftTouchId = null;
    let rightTouchId = null;
    const leftState = { x: 0, y: 0 };
    const lookState = { x: 0, y: 0 };

    function setStickPosition(stickEl, x, y, maxRadius = 34) {
      const length = Math.hypot(x, y);
      const clamped = Math.min(length, maxRadius);
      const angle = Math.atan2(y, x);
      const posX = Math.cos(angle) * clamped;
      const posY = Math.sin(angle) * clamped;
      stickEl.style.transform = `translate(${posX}px, ${posY}px)`;
    }

    function handleTouchStart(event) {
      const jumpRect = jumpButton.getBoundingClientRect();

      if (isInsideRect(event.touches[0].clientX, event.touches[0].clientY, jumpRect)) {
        event.preventDefault();
        queueJump();
        return;
      }

      const t = event.touches[0];
      const rect = leftJoystick.getBoundingClientRect();
      const lookRect = lookPad.getBoundingClientRect();

      if (!leftTouchId && isInsideRect(t.clientX, t.clientY, rect)) {
        leftTouchId = t.identifier;
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const dx = t.clientX - cx;
        const dy = t.clientY - cy;
        leftState.x = dx;
        leftState.y = dy;
        setStickPosition(leftStick, dx, dy, 34);
        return;
      }

      if (!rightTouchId && isInsideRect(t.clientX, t.clientY, lookRect)) {
        rightTouchId = t.identifier;
        return;
      }

      if (leftTouchId === null && rightTouchId === null) {
        if (isUiPointer(t.clientX, t.clientY)) return;

        if (playMode) {
          getPointerFromClient(t.clientX, t.clientY);
          raycaster.setFromCamera(pointer, camera);
          const hitTargets = [
            floor,
            ...placedBlocks,
            ...zombies.map((z) => z.mesh)
          ];
          const hits = raycaster.intersectObjects(hitTargets, false);
          let targetPoint = null;

          if (hits.length) {
            targetPoint = hits[0].point.clone();
          } else {
            const dir = new THREE.Vector3();
            camera.getWorldDirection(dir);
            targetPoint = player.pos.clone().add(new THREE.Vector3(0, 1.2, 0)).add(dir.multiplyScalar(3.5));
          }

          performSwordSwing(targetPoint);
          return;
        }

        getPointerFromClient(t.clientX, t.clientY);
        raycaster.setFromCamera(pointer, camera);

        const hitTargets = [
          floor,
          ...placedBlocks,
          ...zombies.map((z) => z.mesh)
        ];

        const hits = raycaster.intersectObjects(hitTargets, false);

        if (hits.length > 0 && hits[0].object.userData.isBlock) {
          selectedBlock = hits[0].object;
          return;
        }

        handlePlaceOrErase(t.clientX, t.clientY);
      }
    }

    function handleTouchMove(event) {
      for (let i = 0; i < event.touches.length; i++) {
        const touch = event.touches[i];

        if (touch.identifier === leftTouchId) {
          const rect = leftJoystick.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = touch.clientX - cx;
          const dy = touch.clientY - cy;
          const r = 34;
          const len = Math.hypot(dx, dy);
          const clamped = Math.min(len, r);
          const angle = Math.atan2(dy, dx);
          leftState.x = Math.cos(angle) * clamped;
          leftState.y = Math.sin(angle) * clamped;
          setStickPosition(leftStick, leftState.x, leftState.y, r);
        }

        if (touch.identifier === rightTouchId) {
          const rect = lookPad.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const dx = touch.clientX - cx;
          const dy = touch.clientY - cy;
          const max = 42;
          const len = Math.hypot(dx, dy);
          const clamped = Math.min(len, max);
          const angle = Math.atan2(dy, dx);
          lookState.x = Math.cos(angle) * clamped;
          lookState.y = Math.sin(angle) * clamped;
          setStickPosition(lookDot, lookState.x, lookState.y, max);
          player.yaw -= dx * 0.004;
          player.pitch -= dy * 0.003;
          player.pitch = THREE.MathUtils.clamp(player.pitch, -1.5, 1.5);
        }
      }
    }

    function handleTouchEnd(event) {
      for (let i = 0; i < event.changedTouches.length; i++) {
        const touch = event.changedTouches[i];
        if (touch.identifier === leftTouchId) {
          leftTouchId = null;
          leftState.x = 0;
          leftState.y = 0;
          leftStick.style.transform = 'translate(-50%, -50%)';
        }
        if (touch.identifier === rightTouchId) {
          rightTouchId = null;
          lookState.x = 0;
          lookState.y = 0;
          lookDot.style.transform = 'translate(-50%, -50%)';
        }
      }
    }

    window.addEventListener('touchstart', handleTouchStart, { passive: false });
    window.addEventListener('touchmove', handleTouchMove, { passive: false });
    window.addEventListener('touchend', handleTouchEnd, { passive: false });
    window.addEventListener('touchcancel', handleTouchEnd, { passive: false });

    updateModeButton();
    updateEraserButton();
    updateCamera();
    updatePlayerHealthUI();
    setSelectedTool('sword');
    setStatus('Creative');

    const clock = new THREE.Clock();

    function animate() {
      const dt = clock.getDelta();
      updatePlayer(dt);

      for (let i = slashEffects.length - 1; i >= 0; i--) {
        const effect = slashEffects[i];
        effect.life -= dt;
        effect.mesh.scale.x = THREE.MathUtils.lerp(effect.mesh.scale.x, 1.3, 0.18);
        effect.mesh.scale.y = THREE.MathUtils.lerp(effect.mesh.scale.y, 1.1, 0.18);

        const alpha = Math.max(0, effect.life / effect.maxLife);
        const material = effect.mesh.material;
        material.opacity = alpha;

        if (effect.life <= 0) {
          scene.remove(effect.mesh);
          effect.mesh.material.dispose();
          slashEffects.splice(i, 1);
        }
      }

      if (playMode) {
        for (const zombie of zombies) {
          const dx = player.pos.x - zombie.mesh.position.x;
          const dz = player.pos.z - zombie.mesh.position.z;
          const dist = Math.hypot(dx, dz);

          if (dist > 0.01) {
            const dirX = dx / dist;
            const dirZ = dz / dist;

            const nextX = zombie.mesh.position.x + dirX * zombie.speed * dt;
            const nextZ = zombie.mesh.position.z + dirZ * zombie.speed * dt;

            if (!zombieIntersectsBlockAt(zombie, nextX, zombie.mesh.position.z)) {
              zombie.mesh.position.x = nextX;
            }

            if (!zombieIntersectsBlockAt(zombie, zombie.mesh.position.x, nextZ)) {
              zombie.mesh.position.z = nextZ;
            }

            zombie.mesh.rotation.y = Math.atan2(dirX, dirZ);
          }

          if (zombie.damageCooldown > 0) {
            zombie.damageCooldown -= dt;
          }

          const playerDx = player.pos.x - zombie.mesh.position.x;
          const playerDz = player.pos.z - zombie.mesh.position.z;
          const playerDistance = Math.hypot(playerDx, playerDz);

          if (playerDistance < 1.3 && zombie.damageCooldown <= 0) {
            damagePlayer(1);
            zombie.damageCooldown = 1.2;
          }

          zombie.mesh.position.y = 0;
          zombie.hpFill.lookAt(camera.position);
        }
      }

      if (swordSwingTimer > 0) {
        const swing = Math.sin((1 - swordSwingTimer / SWING_DURATION) * Math.PI);
        weapon.rotation.y = 0.22 + swing * 0.9;
        weapon.rotation.z = -0.9 - swing * 1.4;
      } else {
        weapon.rotation.y = 0.22 + Math.sin(performance.now() * 0.003) * 0.04;
        weapon.rotation.z = -0.9 + Math.sin(performance.now() * 0.0025) * 0.03;
      }

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
