    function getBlockBounds(block) {
      const size = block.userData.size || {
        x: block.userData.isLazar ? 1 : blockSize,
        y: block.userData.isLazar ? slabHeight : blockSize,
        z: block.userData.isLazar ? 1 : blockSize
      };

      return {
        hx: size.x / 2,
        hy: size.y / 2,
        hz: size.z / 2
      };
    }

    function blockAABB(block) {
      const size = block.userData.size || {
        x: block.userData.isLazar ? 1 : blockSize,
        y: block.userData.isLazar ? slabHeight : blockSize,
        z: block.userData.isLazar ? 1 : blockSize
      };

      const hx = size.x / 2;
      const hy = size.y / 2;
      const hz = size.z / 2;

      return {
        minX: block.position.x - hx,
        maxX: block.position.x + hx,
        minY: block.position.y - hy,
        maxY: block.position.y + hy,
        minZ: block.position.z - hz,
        maxZ: block.position.z + hz
      };
    }

    function playerIntersectsBlockAt(x, y, z) {
      const minX = x - player.radius;
      const maxX = x + player.radius;
      const minY = y;
      const maxY = y + player.height;
      const minZ = z - player.radius;
      const maxZ = z + player.radius;

      for (const block of placedBlocks) {
        const b = blockAABB(block);

        const isOnTopOfThisBlock =
          y + player.height <= b.maxY + 0.15 &&
          y + player.height >= b.maxY - 0.3 &&
          y <= b.maxY;

        if (isOnTopOfThisBlock) continue;

        const xOverlap = maxX > b.minX && minX < b.maxX;
        const yOverlap = maxY > b.minY && minY < b.maxY;
        const zOverlap = maxZ > b.minZ && minZ < b.maxZ;

        if (xOverlap && yOverlap && zOverlap) {
          return true;
        }
      }
      return false;
    }

    function findStandingBlock() {
      for (const block of placedBlocks) {
        const b = blockAABB(block);
        const xOverlap = player.pos.x + player.radius > b.minX && player.pos.x - player.radius < b.maxX;
        const zOverlap = player.pos.z + player.radius > b.minZ && player.pos.z - player.radius < b.maxZ;

        if (
          xOverlap &&
          zOverlap &&
          player.pos.y + player.height <= b.maxY + 0.15 &&
          player.pos.y + player.height >= b.maxY - 0.3
        ) {
          return b.maxY;
        }
      }
      return null;
    }

    function updatePlayer(dt) {
      const arrowTurnSpeed = 2.2;
      const arrowPitchSpeed = 1.5;

      if (arrowKeys.left) player.yaw += arrowTurnSpeed * dt;
      if (arrowKeys.right) player.yaw -= arrowTurnSpeed * dt;
      if (arrowKeys.up) player.pitch -= arrowPitchSpeed * dt;
      if (arrowKeys.down) player.pitch += arrowPitchSpeed * dt;

      player.pitch = THREE.MathUtils.clamp(player.pitch, -1.45, 1.45);

      let inputX = 0;
      let inputZ = 0;

      if (keys.w) inputZ -= 1;
      if (keys.s) inputZ += 1;
      if (keys.a) inputX -= 1;
      if (keys.d) inputX += 1;

      if (leftTouchId !== null) {
        inputX += leftState.x / 34;
        inputZ += leftState.y / 34;
      }

      if (inputX !== 0 || inputZ !== 0) {
        const len = Math.hypot(inputX, inputZ);
        inputX /= len;
        inputZ /= len;
      }

      const forward = new THREE.Vector3(Math.sin(player.yaw), 0, Math.cos(player.yaw));
      const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));

      const move = new THREE.Vector3();
      move.addScaledVector(forward, -inputZ);
      move.addScaledVector(right, inputX);

      if (move.lengthSq() > 0) {
        move.normalize().multiplyScalar(player.speed * dt);
      } else {
        move.set(0, 0, 0);
      }

      const prevY = player.pos.y;

      const nextX = player.pos.x + move.x;
      if (!playerIntersectsBlockAt(nextX, player.pos.y, player.pos.z)) {
        player.pos.x = nextX;
      }

      const nextZ = player.pos.z + move.z;
      if (!playerIntersectsBlockAt(player.pos.x, player.pos.y, nextZ)) {
        player.pos.z = nextZ;
      }

      if (jumpQueued && (player.onGround || player.standingOnBlockTop !== null)) {
        player.velocityY = 7.8;
        player.onGround = false;
        player.standingOnBlockTop = null;
      }
      jumpQueued = false;

      player.velocityY -= 19.5 * dt;
      const desiredY = player.pos.y + player.velocityY * dt;

      let landedOnBlock = false;
      player.standingOnBlockTop = null;

      for (const block of placedBlocks) {
        const b = blockAABB(block);
        const xOverlap = player.pos.x + player.radius > b.minX && player.pos.x - player.radius < b.maxX;
        const zOverlap = player.pos.z + player.radius > b.minZ && player.pos.z - player.radius < b.maxZ;

        if (!xOverlap || !zOverlap) continue;

        const top = b.maxY;
        const prevFeet = prevY;
        const nextFeet = desiredY;

        if (
          player.velocityY <= 0 &&
          prevFeet + player.height <= top + 0.14 &&
          prevFeet >= top - 1.1 &&
          nextFeet + player.height >= top
        ) {
          player.pos.y = top - player.height;
          player.velocityY = 0;
          player.onGround = true;
          player.standingOnBlockTop = top;
          landedOnBlock = true;
          break;
        }
      }

      if (!landedOnBlock) {
        player.pos.y = desiredY;

        if (player.pos.y < 0) {
          player.pos.y = 0;
          player.velocityY = 0;
          player.onGround = true;
          player.standingOnBlockTop = null;
        } else {
          const top = findStandingBlock();
          if (top !== null) {
            player.pos.y = top - player.height;
            player.velocityY = 0;
            player.onGround = true;
            player.standingOnBlockTop = top;
          } else {
            player.onGround = false;
            player.standingOnBlockTop = null;
          }
        }
      }

      if (player.pos.y <= 0) {
        player.pos.y = 0;
        player.velocityY = 0;
        player.onGround = true;
        player.standingOnBlockTop = null;
      }

      player.pos.x = THREE.MathUtils.clamp(player.pos.x, -35, 35);
      player.pos.z = THREE.MathUtils.clamp(player.pos.z, -35, 35);

      if (player.attackCooldown > 0) {
        player.attackCooldown -= dt;
      }
      if (player.hitFlash > 0) {
        player.hitFlash -= dt;
      }

      if (swordSwingTimer > 0) {
        swordSwingTimer = Math.max(0, swordSwingTimer - dt);
      }

      updateCamera();
      updatePlayerHealthUI();
    }

    const raycaster = new THREE.Raycaster();
