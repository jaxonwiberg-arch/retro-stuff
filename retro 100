      g.beginPath();
      g.moveTo(-60, -64);
      g.quadraticCurveTo(0, 0, 70, 60);
      g.stroke();

      g.strokeStyle = 'rgba(255, 255, 255, 0.95)';
      g.lineWidth = 5;
      g.beginPath();
      g.moveTo(-52, -56);
      g.quadraticCurveTo(0, 0, 58, 52);
      g.stroke();

      const texture = new THREE.CanvasTexture(canvas);
      texture.colorSpace = THREE.SRGBColorSpace;
      return texture;
    }

